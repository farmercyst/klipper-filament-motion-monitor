@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest'
+import { formatFlowPercent, headroomProgress } from '../filamentMotionMetrics'
+
+describe('filament motion meter metrics', () => {
+  it('shows flow unavailable when the backend field is missing or invalid', () => {
+    expect(formatFlowPercent(undefined)).toBe('—')
+    expect(formatFlowPercent(Number.NaN)).toBe('—')
+    expect(formatFlowPercent(Number.POSITIVE_INFINITY)).toBe('—')
+  })
+
+  it('formats backend flow percentage without consulting motion ratios', () => {
+    expect(formatFlowPercent(0)).toBe('0%')
+    expect(formatFlowPercent(73.6)).toBe('74%')
+    expect(formatFlowPercent(140)).toBe('100%')
+  })
+
+  it('maps runout headroom to the independent 300 degree arc progress', () => {
+    expect(headroomProgress(15, 15)).toBe(0)
+    expect(headroomProgress(15, 7.5)).toBe(0.5)
+    expect(headroomProgress(15, 0)).toBe(1)
+  })
+
+  it('clamps excessive or invalid runout values safely', () => {
+    expect(headroomProgress(15, 30)).toBe(0)
+    expect(headroomProgress(15, -5)).toBe(1)
+    expect(headroomProgress(0, 0)).toBe(0)
+    expect(headroomProgress(15, undefined)).toBe(0)
+  })
+})
diff --git a/src/components/widgets/filament-motion-monitor/filamentMotionMetrics.ts b/src/components/widgets/filament-motion-monitor/filamentMotionMetrics.ts
