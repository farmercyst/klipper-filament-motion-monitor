@@ -0,0 +1,124 @@
+<template>
+  <svg
+    viewBox="0 0 140 140"
+    preserveAspectRatio="xMidYMid meet"
+    :class="{ 'disabled-meter': !enabled }"
+    role="img"
+    :aria-label="ariaLabel"
+  >
+    <g transform="rotate(120 70 70)">
+      <circle
+        cx="70"
+        cy="70"
+        r="50"
+        class="v-progress-circular__underlay"
+        fill="transparent"
+        stroke-width="18"
+        :stroke-dasharray="circumference"
+        :stroke-dashoffset="dialArc"
+      />
+      <circle
+        cx="70"
+        cy="70"
+        r="50"
+        class="primary-color meter-arc"
+        fill="transparent"
+        stroke-width="18"
+        stroke-linecap="round"
+        :stroke-dasharray="circumference"
+        :stroke-dashoffset="dashOffset"
+      />
+    </g>
+
+    <text
+      x="70"
+      y="56"
+      text-anchor="middle"
+      class="small-text-color"
+      font-size="11px"
+    >{{ $t('app.filament_motion_monitor.label.flow') }}</text>
+    <text
+      x="70"
+      y="81"
+      text-anchor="middle"
+      class="value-text-color"
+      font-size="20px"
+    >{{ flowLabel }}</text>
+    <text
+      x="31"
+      y="139"
+      text-anchor="end"
+      class="small-text-color"
+      font-size="12px"
+    >{{ endpointLabel(runoutLength) }}</text>
+    <text
+      x="107"
+      y="139"
+      class="small-text-color"
+      font-size="12px"
+    >0 mm</text>
+  </svg>
+</template>
+
+<script lang="ts">
+import { Component, Prop, Vue } from 'vue-property-decorator'
+import { formatFlowPercent, headroomProgress } from './filamentMotionMetrics'
+
+@Component({})
+export default class FilamentMotionMeter extends Vue {
+  @Prop({ type: Number, default: null })
+  readonly flowRate!: number | null
+
+  @Prop({ type: Number, default: 0 })
+  readonly runoutLength!: number
+
+  @Prop({ type: Number, default: 0 })
+  readonly runoutRemaining!: number
+
+  @Prop({ type: Boolean, default: true })
+  readonly enabled!: boolean
+
+  readonly circumference: number = 2 * Math.PI * 50
+  readonly dialArc: number = this.circumference * (60 / 360)
+
+  get flowLabel (): string {
+    return formatFlowPercent(this.flowRate)
+  }
+
+  get ariaLabel (): string {
+    return this.flowLabel === '—'
+      ? this.$t('app.filament_motion_monitor.label.flow_unavailable').toString()
+      : this.$t('app.filament_motion_monitor.label.flow_aria', {
+        percent: this.flowLabel
+      }).toString()
+  }
+
+  get dashOffset (): number {
+    const progress = headroomProgress(this.runoutLength, this.runoutRemaining)
+
+    return this.circumference * (1 - progress * (300 / 360))
+  }
+
+  endpointLabel (value: number): string {
+    return Number.isFinite(value) && value > 0 ? `${value.toFixed(1)} mm` : '— mm'
+  }
+}
+</script>
+
+<style scoped>
+.disabled-meter {
+  opacity: 0.5;
+}
+.meter-arc {
+  transition: stroke-dashoffset 0.35s ease-out;
+}
+.primary-color {
+  stroke: var(--v-primary-lighten1, #2ca9bc);
+}
+.small-text-color {
+  fill: var(--v-primary-lighten1, #2ca9bc);
+}
+.value-text-color {
+  fill: currentColor;
+}
+</style>
