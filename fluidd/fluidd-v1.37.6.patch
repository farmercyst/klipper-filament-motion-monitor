index 0000000..1c56681
--- /dev/null
+++ b/src/components/widgets/filament-motion-monitor/filamentMotionMetrics.ts
@@ -0,0 +1,17 @@
+export const formatFlowPercent = (flowRate: unknown): string => {
+  if (typeof flowRate !== 'number' || !Number.isFinite(flowRate)) return '—'
+
+  return `${Math.max(0, Math.min(100, Math.round(flowRate)))}%`
+}
+
+export const headroomProgress = (runoutLength: unknown, runoutRemaining: unknown): number => {
+  if (
+    typeof runoutLength !== 'number' ||
+    !Number.isFinite(runoutLength) ||
+    runoutLength <= 0 ||
+    typeof runoutRemaining !== 'number' ||
+    !Number.isFinite(runoutRemaining)
+  ) return 0
+
+  return Math.max(0, Math.min(1, (runoutLength - runoutRemaining) / runoutLength))
+}
